{
  "name": "agent-video-player",
  "version": "0.1.0",
  "description": "AgentVideoPlayer",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/patch-dev-exe.js",
    "dist": "node scripts/dist.js"
  },
  "build": {
    "appId": "com.local.agentvideoplayer",
    "productName": "AgentVideoPlayer",
    "directories": {
      "output": "build-out"
    },
    "files": [
      "main/**",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "AgentVideoPlayer-Portable.exe"
    },
    "nsis": {
      "artifactName": "AgentVideoPlayer-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
